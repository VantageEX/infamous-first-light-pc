# Renderer v3's switches (glue/gpu_host.cpp reads none of them: the fork's video core does, from the
# environment). The tested build's own set: axylpup's second-son-v1.1.1 release (shadps4-flags.txt),
# less what this port does itself (DLSS, controls, texture replacement, video decoding, save
# dialogs, the cache name). The launcher passes these when renderer v3 is picked; a variable already
# set wins.
SHADPS4_A2=1
SHADPS4_A2_INDIRECT=1
SHADPS4_A2_MAT_MEMO=1
SHADPS4_A2_PARK=1
