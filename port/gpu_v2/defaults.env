ISS_UNIFIED_RANGE=0x1048000000:0x20000000
# Blended draws into this color target stay on the command processor: the pause menu reuses it as its
# UI layer and native blended segments there hung the GPU. Castlesea's default 203d70000 is in its heap
# C (0x200000000); this port's runtime maps heap C at 0x1068000000, the same target is at 0x106BD70000.
ISS_NATIVE_PASSES_BLEND_DENY=106BD70000
